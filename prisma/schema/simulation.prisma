// Ticks, phase runs, domain events, snapshots, and AI decision logs.

enum TickStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  RETRYABLE
  NEEDS_REPAIR

  @@map("tick_status")
}

enum PhaseStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED

  @@map("phase_status")
}

enum SnapshotStatus {
  CREATING
  READY
  FAILED
  EXPIRED

  @@map("snapshot_status")
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED

  @@map("outbox_status")
}

// At most one RUNNING tick per world (partial unique index in migration).
// The lease lets another worker reclaim a tick whose worker died.
model SimulationTick {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  worldId        String     @map("world_id") @db.Uuid
  tickNumber     Int        @map("tick_number")
  status         TickStatus @default(PENDING)
  modelVersion   String     @map("model_version")
  claimedBy      String?    @map("claimed_by")
  leaseExpiresAt DateTime?  @map("lease_expires_at") @db.Timestamptz(3)
  startedAt      DateTime?  @map("started_at") @db.Timestamptz(3)
  completedAt    DateTime?  @map("completed_at") @db.Timestamptz(3)
  errorCode      String?    @map("error_code")

  world  GameWorld            @relation(fields: [worldId], references: [id], onDelete: Cascade)
  phases SimulationPhaseRun[]

  @@unique([worldId, tickNumber])
  @@index([worldId, status])
  @@map("simulation_ticks")
}

// One row per (tick, phase); `attempt` counts retries of that phase.
model SimulationPhaseRun {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  worldId        String      @map("world_id") @db.Uuid
  tickNumber     Int         @map("tick_number")
  phaseName      String      @map("phase_name")
  status         PhaseStatus @default(PENDING)
  attempt        Int         @default(1)
  operationCount Int         @default(0) @map("operation_count")
  metrics        Json        @default("{}")
  errorCode      String?     @map("error_code")
  startedAt      DateTime?   @map("started_at") @db.Timestamptz(3)
  completedAt    DateTime?   @map("completed_at") @db.Timestamptz(3)

  tick SimulationTick @relation(fields: [worldId, tickNumber], references: [worldId, tickNumber], onDelete: NoAction)

  @@unique([worldId, tickNumber, phaseName])
  @@map("simulation_phase_runs")
}

// Domain events are facts. eventId is the stable identity for consumers.
model SimulationEvent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  worldId       String   @map("world_id") @db.Uuid
  tickNumber    Int      @map("tick_number")
  sequence      Int
  eventType     String   @map("event_type")
  schemaVersion Int      @default(1) @map("schema_version")
  aggregateType String   @map("aggregate_type")
  aggregateId   String   @map("aggregate_id") @db.Uuid
  payload       Json
  correlationId String?  @map("correlation_id") @db.Uuid
  causationId   String?  @map("causation_id") @db.Uuid
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  world  GameWorld       @relation(fields: [worldId], references: [id], onDelete: Cascade)
  outbox OutboxMessage[]
  news   NewsArticle[]

  @@unique([worldId, tickNumber, sequence])
  @@index([worldId, aggregateType, aggregateId])
  @@map("simulation_events")
}

// Transactional outbox: written in the same transaction as the state change,
// published to queues/realtime afterwards.
model OutboxMessage {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId     String       @map("event_id") @db.Uuid
  topic       String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt DateTime?    @map("published_at") @db.Timestamptz(3)

  event SimulationEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, topic])
  @@index([status, createdAt])
  @@map("outbox_messages")
}

// A consistent checkpoint. Large state goes to storageReference, not payload.
model WorldSnapshot {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  worldId          String         @map("world_id") @db.Uuid
  tickNumber       Int            @map("tick_number")
  schemaVersion    Int            @map("schema_version")
  modelVersion     String         @map("model_version")
  formatVersion    Int            @default(1) @map("format_version")
  storageReference String?        @map("storage_reference")
  checksum         String?
  status           SnapshotStatus @default(CREATING)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  world GameWorld @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@unique([worldId, tickNumber, formatVersion])
  @@map("world_snapshots")
}

// Concise rationale only; never store raw model inputs here.
model AiDecisionLog {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  worldId             String   @map("world_id") @db.Uuid
  companyId           String   @map("company_id") @db.Uuid
  tickNumber          Int      @map("tick_number")
  decisionType        String   @map("decision_type")
  inputSummary        Json     @map("input_summary")
  alternativesSummary Json     @map("alternatives_summary")
  chosenAction        Json     @map("chosen_action")
  expectedOutcome     Json?    @map("expected_outcome")
  actualOutcome       Json?    @map("actual_outcome")
  resultReference     String?  @map("result_reference")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company @relation(fields: [worldId, companyId], references: [worldId, id], onDelete: NoAction)

  @@index([worldId, companyId, tickNumber])
  @@map("ai_decision_logs")
}

// Macro and market statistics per tick. regionId null = whole world.
model EconomicIndicator {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  worldId       String  @map("world_id") @db.Uuid
  tickNumber    Int     @map("tick_number")
  regionId      String? @map("region_id") @db.Uuid
  indicatorCode String  @map("indicator_code")
  value         Decimal @db.Decimal(24, 8)

  world GameWorld @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@unique([worldId, tickNumber, indicatorCode, regionId])
  @@map("economic_indicators")
}
